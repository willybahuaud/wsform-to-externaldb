msgid "Column “%s” expects a number."
msgstr "La colonne « %s » attend un nombre."

#. translators: %s: setting name
#: includes/class-security.php:45
#, php-format
msgid "The “%s” setting is required."
msgstr "Le paramètre « %s » est requis."

#: includes/class-security.php:59
msgid "The port must be between 1 and 65535."
msgstr "Le port doit être compris entre 1 et 65535."

#: includes/class-security.php:85
msgid "The host must be an IP address or a domain name, without a port."
msgstr "L’hôte doit être une adresse IP ou un nom de domaine, sans port."

#. translators: %s: rejected identifier
#: includes/class-security.php:106
#, php-format
msgid "SQL identifier rejected: “%s”. Only unaccented letters, digits, _ and $ are allowed."
msgstr "Identifiant SQL refusé : « %s ». Seuls les lettres non accentuées, chiffres, _ et $ sont acceptés."

#. translators: %s: table name
#: includes/class-table-analyzer.php:82
#, php-format
msgid "Table “%s” does not exist in the external database."
msgstr "La table « %s » n’existe pas dans la base externe."

#. translators: %s: constant name
#: includes/class-wordpress-guard.php:73
#, php-format
msgid "This connection leads to the WordPress database, which is refused by default. To allow specific tables, define %s in wp-config.php."
msgstr "Cette connexion mène à la base de données WordPress, refusée par défaut. Pour autoriser des tables précises, définissez %s dans wp-config.php."

#. translators: 1: table name, 2: constant name
#: includes/class-wordpress-guard.php:100
#, php-format
msgid "WordPress database table “%1$s” is not allowed. Add it to %2$s in wp-config.php."
msgstr "La table « %1$s » de la base WordPress n’est pas autorisée. Ajoutez-la à %2$s dans wp-config.php."

