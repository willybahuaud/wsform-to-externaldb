#. Plugin Name of the plugin
#: wsform-to-externaldb.php
msgid "External Database for WS Form"
msgstr "Base de données externe pour WS Form"

#. Description of the plugin
#: wsform-to-externaldb.php
msgid ""
"Adds a WS Form action that inserts submissions into an external MySQL or "
"MariaDB database."
msgstr ""
"Ajoute une action WS Form qui insère les soumissions dans une base de "
"données externe MySQL ou MariaDB."

#. Author of the plugin
#: wsform-to-externaldb.php
msgid "Willy Bahuaud"
msgstr "Willy Bahuaud"

#. Author URI of the plugin
#: wsform-to-externaldb.php
msgid "https://wabeo.fr"
msgstr "https://wabeo.fr"

