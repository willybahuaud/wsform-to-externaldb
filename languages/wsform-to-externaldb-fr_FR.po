msgid "%1$d submission could not be inserted. Last failure on form #%2$d, on %3$s. The data is still in the WS Form submissions."
msgid_plural "%1$d submissions could not be inserted. Last failure on form #%2$d, on %3$s. The data is still in the WS Form submissions."
msgstr[0] "%1$d soumission n’a pas pu être insérée. Dernier échec sur le formulaire #%2$d, le %3$s. Les données restent dans les soumissions WS Form."
msgstr[1] "%1$d soumissions n’ont pas pu être insérées. Dernier échec sur le formulaire #%2$d, le %3$s. Les données restent dans les soumissions WS Form."

