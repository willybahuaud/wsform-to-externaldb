<?xml version="1.0"?>
<ruleset name="WS Form to External DB">
    <description>Regles PHPCS pour le plugin WS Form to External DB.</description>

    <file>.</file>
    <arg name="extensions" value="php" />
    <arg value="sp" />

    <rule ref="WordPress-Core" />
    <rule ref="WordPress-Docs" />
    <rule ref="WordPress-Extra" />
    <rule ref="PHPCompatibilityWP" />

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wsform-to-externaldb" />
            </property>
        </properties>
    </rule>

    <!-- Le projet utilise un autoloader custom qui retire le préfixe WS_Form_DB_ du nom de fichier -->
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>includes/*</exclude-pattern>
    </rule>

    <config name="minimum_supported_wp_version" value="6.0" />
    <config name="testVersion" value="7.4-" />

    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>languages/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>
    <exclude-pattern>admin/js/*</exclude-pattern>
    <exclude-pattern>admin/css/*</exclude-pattern>
    <exclude-pattern>build/*</exclude-pattern>
    <exclude-pattern>dist/*</exclude-pattern>
</ruleset>
